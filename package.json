{
  "name": "agentic-roadmap",
  "version": "0.1.0",
  "description": "A roadmap in YAML that people and coding agents follow from the command line: what to do next, who started what, and closing a task with its commit.",
  "keywords": [
    "agent-skill",
    "ai-agents",
    "claude-code",
    "cli",
    "coding-agents",
    "critical-path",
    "dependencies",
    "git",
    "parallel",
    "plan",
    "planning",
    "roadmap",
    "task-tracker",
    "tasks",
    "worktrees",
    "yaml"
  ],
  "homepage": "https://github.com/jaumarro/agentic-roadmap#readme",
  "bugs": "https://github.com/jaumarro/agentic-roadmap/issues",
  "license": "MIT",
  "author": "Jaume Nicolau Prohens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaumarro/agentic-roadmap.git"
  },
  "bin": {
    "agentic-roadmap": "./dist/cli.js",
    "roadmap": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "pnpm build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "vitest run",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
